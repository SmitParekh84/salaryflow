# --- Database ---
# Local example. For Atlas, use its generated mongodb+srv URI with strict TLS.
MONGODB_URI=mongodb://127.0.0.1:27017/aartha

# --- Auth ---
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000

# --- App ---
NEXT_PUBLIC_APP_NAME=Aartha
# Public origin used for images inside transactional email. Recipients fetch
# these over the internet, so it must be a real reachable host — not localhost.
# Defaults to https://aartha.app; point it at your current host until that
# domain is live.
NEXT_PUBLIC_SITE_ORIGIN=https://aartha.app

# --- Email (Resend) ---
# Required for registration and password-reset emails.
# RESEND_FROM must use a domain verified in your Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Aartha <noreply@your-verified-domain.com>"

# --- Development-only admin seeding ---
ENABLE_DEV_ADMIN_SEED=false
DEV_ADMIN_SEED_TOKEN=replace-with-a-random-development-token
