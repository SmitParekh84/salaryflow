# --- Database ---
# Local example. For Atlas, use its generated mongodb+srv URI with strict TLS.
MONGODB_URI=mongodb://127.0.0.1:27017/spendly

# --- Auth ---
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000

# --- App ---
NEXT_PUBLIC_APP_NAME=Spendly

# --- Email (Resend) ---
# Required for registration and password-reset emails.
# RESEND_FROM must use a domain verified in your Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Spendly <noreply@your-verified-domain.com>"

# --- Development-only admin seeding ---
ENABLE_DEV_ADMIN_SEED=false
DEV_ADMIN_SEED_TOKEN=replace-with-a-random-development-token
